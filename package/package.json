{
  "name": "tinywidgets",
  "version": "1.8.1",
  "author": "jamesgpearce",
  "repository": "github:tinyplex/tinywidgets",
  "license": "MIT",
  "homepage": "https://tinywidgets.org",
  "description": "A collection of tiny, reusable, UI components - wrapped in a helpful app layout with header, side bar, dark mode, and more.",
  "keywords": [
    "tiny",
    "local-first",
    "ui",
    "components",
    "styling",
    "react"
  ],
  "type": "module",
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prePublishPackage": "npm i && prettier --check . && eslint . && cspell --quiet . && tsc && npm test && npm run build && node scripts/checkPackageFiles.mjs && npm run test:package",
    "test": "vitest run",
    "test:package": "node scripts/testPackage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/vite-plugin": "^5.2.5",
    "cspell": "^10.0.1",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": "./src/index.ts",
    "./css": "./src/index.css.ts",
    "./source": "./src/index.ts",
    "./source/css": "./src/index.css.ts",
    "./prebuilt": {
      "types": "./dist/prebuilt/index.d.ts",
      "import": "./dist/prebuilt/index.js",
      "default": "./dist/prebuilt/index.js"
    },
    "./prebuilt/css": {
      "types": "./dist/prebuilt/index.css.d.ts",
      "import": "./dist/prebuilt/css.js",
      "default": "./dist/prebuilt/css.js"
    },
    "./prebuilt/styles.css": {
      "types": "./dist/prebuilt/styles.css.d.ts",
      "default": "./dist/prebuilt/styles.css"
    }
  },
  "dependencies": {
    "@types/react-is": "^19.2.0",
    "@vanilla-extract/css": "^1.21.1",
    "lucide-react": "^1.25.0",
    "react-is": "^19.2.7",
    "tinybase": "^9.2.0"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
